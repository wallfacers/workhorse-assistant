{
  "name": "workhorse-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "sync-sidecar": "bash scripts/sync-sidecar.sh --build",
    "tauri:dev": "bash scripts/sync-sidecar.sh --build && tauri dev",
    "tauri:build": "bash scripts/sync-sidecar.sh --build && tauri build",
    "design:lint": "design.md lint docs/DESIGN.md",
    "design:export:css": "design.md export --format tailwind docs/DESIGN.md > src/design-tokens.generated.css"
  },
